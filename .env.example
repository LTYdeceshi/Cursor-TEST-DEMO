# ============================================
# 邮件推送配置 - 请复制此文件为 .env 并填写实际值
# ============================================

# SMTP 服务器配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true

# SMTP 认证 (Gmail 需使用应用专用密码)
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# 发件人和收件人
SENDER_EMAIL=your-email@gmail.com
RECIPIENT_EMAIL=recipient@example.com

# 支持多个收件人，用逗号分隔:
# RECIPIENT_EMAIL=user1@example.com,user2@example.com

# ============================================
# 常见 SMTP 配置参考:
# ============================================
# Gmail:     SMTP_HOST=smtp.gmail.com      SMTP_PORT=465  SMTP_USE_SSL=true
# QQ邮箱:   SMTP_HOST=smtp.qq.com         SMTP_PORT=465  SMTP_USE_SSL=true
# 163邮箱:  SMTP_HOST=smtp.163.com        SMTP_PORT=465  SMTP_USE_SSL=true
# Outlook:   SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_USE_SSL=false
# 阿里企业:  SMTP_HOST=smtp.qiye.aliyun.com SMTP_PORT=465 SMTP_USE_SSL=true
